---
import { Image } from 'astro:assets';
import { marked } from 'marked';
import { getLatestNews } from '../lib/news';

const siste = await getLatestNews();

const nyhetsbilder = import.meta.glob<{ default: ImageMetadata }>('/src/images/nyheter/*', {
    eager: true,
});
const bildeEntry = siste?.image
    ? Object.entries(nyhetsbilder).find(([path]) => path.endsWith(`/${siste.image}`))
    : undefined;
const bilde = bildeEntry?.[1].default;

const bodyHtml = siste?.body ? marked.parse(siste.body) : '';
---

{
    siste && (
        <section class='border border-dotted border-[#efb261] rounded-xs w-full'>
            <h4 class='p-2 text-sm bg-[#efb261] font-bold'>Siste nytt fra forlaget</h4>
            <article class='p-2 m-2'>
                <h2>{siste.tittel}</h2>
                {bilde && (
                    <figure>
                        <Image src={bilde} alt={siste.tittel} loading='lazy' />
                    </figure>
                )}
                <div class='prose max-w-none' set:html={bodyHtml} />
                <a href='/nyheter' class='inline-block mt-2 text-sm underline hover:no-underline'>
                    Eldre nyheter →
                </a>
            </article>
        </section>
    )
}
