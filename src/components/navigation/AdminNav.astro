---
const pathname = new URL(Astro.request.url).pathname;

const links = [
    { href: '/bakrommet', label: 'Dashboard', exact: true },
    { href: '/bakrommet/nyheter', label: 'Siste nytt', exact: false },
    { href: '/bakrommet/utgivelser', label: 'Utgivelser', exact: false },
];
---

<nav class='self-center justify-self-end flex flex-wrap items-center gap-2'>
    {
        links.map((link) => (
            <a
                href={link.href}
                class={
                    pathname === link.href ||
                    (!link.exact && pathname.startsWith(link.href + '/'))
                        ? 'bg-[#422006] text-amber-100 px-3 py-2 rounded-xs text-sm font-medium'
                        : 'text-[#422006] hover:bg-black/10 px-3 py-2 rounded-xs text-sm font-medium'
                }
            >
                {link.label}
            </a>
        ))
    }
    <form method='POST' action='/bakrommet/logout'>
        <input
            type='submit'
            value='Logg ut'
            class='px-3 py-2 rounded-xs bg-black text-white text-sm cursor-pointer hover:bg-gray-800'
        />
    </form>
</nav>
