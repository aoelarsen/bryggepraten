---
import utgivelserData from '../../constants/utgivelser.json';
import type { Bok } from '../../lib/contentTypes';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);

const bryggepraten = (utgivelserData.utgivelser.bryggepraten as Bok[]).filter(
    (b): b is Bok & { slug: string } => Boolean(b.slug),
);
const andreForfattere = (utgivelserData.utgivelser.andre_forfattere as Bok[]).filter(
    (b): b is Bok & { slug: string } => Boolean(b.slug),
);

const linkClass = (slug: string) =>
    currentPath === `utgivelser/${slug}`
        ? 'bg-gray-900 text-white px-3 py-2 rounded-xs text-sm font-medium active:text-white'
        : 'text-blue-600 hover:text-blue-200 focus:text-blue-800 hover:bg-gray-700 px-3 py-2 rounded-xs text-sm font-medium active:text-white';
---

<div
    class='relative inline-block text-left place-self-center w-full md:place-self-end lg:w-1/2 col-span-full md:col-auto md:col-start-3'
>
    <div>
        <button
            type='button'
            class='inline-flex w-full justify-center rounded-xs border border-gray-300 px-4 py-2 text-sm font-medium shadow-xs focus:outline-hidden focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-100 bg-[#efb261] text-black text-secondary hover:text-amber-100 hover:bg-yellow-900'
            id='utgivelserBtn'
            aria-expanded='true'
            aria-haspopup='true'
        >
            Utgivelser
            <!-- Heroicon name: mini/chevron-down -->
            <svg
                class='-mr-1 ml-2 h-5 w-5'
                xmlns='http://www.w3.org/2000/svg'
                viewBox='0 0 20 20'
                fill='currentColor'
                aria-hidden='true'
            >
                <path
                    fill-rule='evenodd'
                    d='M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z'
                    clip-rule='evenodd'></path>
            </svg>
        </button>
    </div>
    <div
        class='hidden absolute right-0 z-10 mt-2 w-full md:w-56 lg:w-full origin-top-right rounded-xs bg-white shadow-lg ring-1 ring-black/5 focus:outline-hidden'
        role='menu'
        aria-orientation='vertical'
        aria-labelledby='menu-button'
        tabindex='-1'
        id='utgivelserMenu'
    >
        <div class='py-1 flex flex-col w-full' role='none'>
            {
                bryggepraten.map((bok) => (
                    <a href={`/utgivelser/${bok.slug}`} class={linkClass(bok.slug)}>
                        {bok.tittel}
                    </a>
                ))
            }
            <hr />
            {
                andreForfattere.map((bok) => (
                    <a href={`/utgivelser/${bok.slug}`} class={linkClass(bok.slug)}>
                        {bok.tittel}
                    </a>
                ))
            }
        </div>
    </div>
</div>

<script is:inline>
    document.addEventListener('astro:page-load', () => {
        const dropBtn = document.getElementById('utgivelserBtn');
        const dropMenu = document.getElementById('utgivelserMenu');

        const handleDropDown = () => {
            dropMenu.classList.contains('hidden')
                ? dropMenu.classList.replace('hidden', 'block')
                : dropMenu.classList.replace('block', 'hidden');
        };
        dropBtn.addEventListener('click', handleDropDown);
    });
</script>
